DATABASE_URL=postgresql+psycopg://crm:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/crm_business
POSTGRES_PASSWORD=replace-with-your-local-database-password
# Use the Neon DIRECT connection for Alembic, the POOLED connection at runtime.
MIGRATION_DATABASE_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
COOKIE_SECURE=false
DEMO_MODE=true
ENABLE_DEMO_RESET=false
REPORT_TIMEZONE=Asia/Jakarta
# Override only in disposable demo environments; never reuse in real systems.
DEMO_PASSWORD=PortfolioDemo!2026
# Separate disposable PostgreSQL database used by integration tests.
TEST_DATABASE_URL=
